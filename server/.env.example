NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/isimg-clubhub

JWT_ACCESS_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=./uploads
MAX_AVATAR_SIZE=2097152
MAX_POSTER_SIZE=5242880
MAX_FORM_FILE_SIZE=10485760
MAX_RECEIPT_SIZE=3145728
